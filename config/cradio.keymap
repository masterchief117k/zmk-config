#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Home row mods macro (Left hand preserved using standard ZMK modifier syntax)
#define HRML(k1,k2,k3,k4) &ht LSHIFT k1  &ht LALT k2  &ht LCTRL k3  &ht LGUI k4

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = ;
            flavor = "tap-preferred";
            tapping-term-ms = ;
            quick-tap-ms = ;
            require-prior-idle-ms = ;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Alphanumeric Failsafe Combos (Allows typing dead keys without layer switching)
        combo_r   { timeout-ms = ; key-positions = <2 4>; bindings = <&kp R>; };    // E + T = R
        combo_y   { timeout-ms = ; key-positions = <6 7>; bindings = <&kp Y>; };    // U + I = Y
        combo_j   { timeout-ms = ; key-positions = <15 17>; bindings = <&kp J>; };  // H + K = J
        combo_dot { timeout-ms = ; key-positions = <27 29>; bindings = <&kp DOT>; };// COMMA + FSLH = DOT
        combo_z   { timeout-ms = ; key-positions = <21 23>; bindings = <&kp Z>; };   // X + V = Z
        combo_c   { timeout-ms = ; key-positions = <12 21>; bindings = <&kp C>; };   // D + X = C
        combo_b   { timeout-ms = ; key-positions = <14 23>; bindings = <&kp B>; };   // G + V = B

        // Gaming Layer Toggle (Pressing Q + W simultaneously toggles Layer 4)
        combo_gaming { timeout-ms = ; key-positions = <0 1>; bindings = <&tog 4>; };

        // Numpad Layer Toggle (Pressing W + E simultaneously toggles Layer 5)
        combo_numpad { timeout-ms = ; key-positions = <1 2>; bindings = <&tog 5>; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = ;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        
        default_layer { // Layer 0
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Q       │  W       │  E       │ DEAD (R) │  T       │   │ DEAD (Y) │  U       │  I       │  O       │  P       │
            &kp Q      &kp W      &kp E      &none      &kp T          &none      &kp U      &kp I      &kp O      &kp P
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  A       │  S       │  D       │  F       │  G       │   │  H       │ DEAD (J) │  K       │  L       │ ' "      │
            HRML(A,    S,         D,         F)         &kp G          &kp H      &none      &ht RCTRL K &ht RALT L &ht RSHIFT SQT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│ DEAD (Z) │  X       │ DEAD (C) │  V       │ DEAD (B) │   │  N       │  M       │ , <      │ DEAD (.) │ /?      │
            &none      &kp X      &none      &kp V      &none          &kp N      &kp M      &kp COMMA  &none      &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                            &lt 2 TAB  &kp ENTER      &kp SPACE  &lt 1 BSPC
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        right_layer { // Layer 1
            bindings = <
            &kp INS    &kp N1     &kp N2     &none      &kp N3         &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp COLON
            &kp DEL    &kp N4     &kp N5     &kp N6     &none          &kp LEFT   &none      &kp UP     &kp RIGHT  &kp SEMI
            &caps_word &kp N7     &kp N8     &kp N9     &none          &kp DOWN   &trans     &trans     &none      &trans
                                             &trans     &kp ESC        &trans     &trans
            >;
        };

        left_layer { // Layer 2
            bindings = <
            &trans     &kp LBKT   &kp LBRC   &none      &trans         &none      &kp LPAR   &kp RPAR   &kp RBKT   &kp TILDE
            &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp ASTRK  &none      &kp EQUAL  &kp BSLH   &kp GRAVE
            &none      &trans     &none      &trans     &none          &kp AMPS   &kp UNDER  &kp PLUS   &none      &trans
                                             &trans     &trans         &trans     &trans
            >;
        };

        tri_layer { // Layer 3
            // BROKEN KEYS ROUTED HERE: Accessed by holding both thumb keys. 
            // Placed ergonomically near their original fingers.
            bindings = <
            &sys_reset  &trans     &kp R      &none     &bt BT_SEL 0   &none      &kp Y      &trans     &trans     &sys_reset
            &bootloader &trans     &trans     &trans    &bt BT_SEL 1   &trans     &none      &kp J      &trans     &bootloader
            &none       &kp Z      &none      &kp C     &none          &kp B      &trans     &trans     &none      &kp DOT
                                              &trans    &trans         &trans     &trans
            >;
        };

        gaming_layer { // Layer 4
            // PURE TAP OUTPUTS: HRMs are disabled on WASD for zero-latency gameplay.
            // Dead R key is remapped to T's spot so reloading is functional.
            bindings = <
            &kp Q      &kp W      &kp E      &none      &kp R          &none      &kp U      &kp I      &kp O      &kp P
            &kp A      &kp S      &kp D      &kp F      &kp G          &kp H      &none      &kp K      &kp L      &kp SQT
            &none      &kp X      &none      &kp V      &none          &kp N      &kp M      &kp COMMA  &none      &kp FSLH
                                             &kp LCTRL  &kp SPACE      &kp ENTER  &tog 4
            >;
        };

        num_layer { // Layer 5
            // DEDICATED NUMPAD: Accessed via W+E combo. Completely localized to healthy right-hand switches.
            bindings = <
            &trans     &trans     &trans     &none      &trans         &none      &trans     &kp N7     &kp N8     &kp N9
            &trans     &trans     &trans     &trans     &trans         &trans     &none      &kp N4     &kp N5     &kp N6
            &none      &trans     &none      &trans     &none          &kp N1     &kp N2     &kp N3     &none      &kp N0
                                             &trans     &trans         &trans     &tog 5
            >;
        };
    };
};
