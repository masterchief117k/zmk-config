#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Home row mods macro
#define HRML(k1,k2,k3,k4) &ht LSHFT k1  &ht LALT k2  &ht LCTRL k3  &ht LGUI k4
#define HRMR(k1,k2,k3,k4) &ht RGUI k1  &ht RCTRL k2  &ht RALT k3  &ht RSHFT k4

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
    };
    combos {
        compatible = "zmk,combos";

        // Alphanumeric Failsafe Combos (Allows typing dead keys without layer switching)
        combo_r   { timeout-ms = ; key-positions = <2 4>; bindings = <&kp R>; };    // E + T = R
        combo_y   { timeout-ms = ; key-positions = <6 7>; bindings = <&kp Y>; };    // U + I = Y
        combo_j   { timeout-ms = ; key-positions = <15 17>; bindings = <&kp J>; };  // H + K = J
        combo_dot { timeout-ms = ; key-positions = <27 29>; bindings = <&kp DOT>; };// COMMA + FSLH = DOT
        combo_z   { timeout-ms = ; key-positions = <21 23>; bindings = <&kp Z>; };   // X + V = Z
        combo_c   { timeout-ms = ; key-positions = <12 21>; bindings = <&kp C>; };   // D + X = C
        combo_b   { timeout-ms = ; key-positions = <14 23>; bindings = <&kp B>; };   // G + V = B

        // Gaming Layer Toggle (Pressing Q + W simultaneously toggles Layer 4)
        combo_gaming { timeout-ms = ; key-positions = <0 1>; bindings = <&tog 4>; };

        // Numpad Layer Toggle (Pressing W + E simultaneously toggles Layer 5)
        combo_numpad { timeout-ms = ; key-positions = <1 2>; bindings = <&tog 5>; };
    };


    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Q       │  W       │  E       │          │  T       │   │  Y       │  U       │  I       │  O       │  P       │
            &kp Q      &kp W      &kp E      &none      &kp T          &kp Y      &kp U      &kp I      &kp O      &kp P
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  A       │  S       │  D       │  F       │  G       │   │  H       │          │  K       │  L       │ ' "      │
           &ht LSFT    &ht LALT  &th LCTRL D &ht LGUI F  &kp G          &kp H     &none     &ht RCTL K &ht RALT L &ht RFT SQT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  Z       │  X       │          │  V       │          │   │  N       │  M       │ , <      │          │ / ?      │
            &none      &kp X      &none      &kp V      &none           &kp N      &kp M      &kp COMMA  &none      &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                            &lt 2 TAB   &kp ENTER     &kp SPACE  &lt 1 BSPC
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        right_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│ INSERT   │  1       │  2       │          │          │   │          │ PAGE DN  │ PAGE UP  │ END      │  :       │
            &kp INS    &kp N1     &kp N2     &none      &trans         &none     &kp PG_DN  &kp PG_UP  &kp END    &kp COLON
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│ DELETE   │  4       │  5       │  6       │          │   │ LEFT     │          │ UP       │ RIGHT    │  ;       │
            &kp DEL    &kp N4     &kp N5     &kp N6     &trans         &kp LEFT   &none       &kp UP   &kp RIGHT   &kp SEMI
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │  7       │          │  9       │          │   │          │          │          │          │          │
           &none       &kp N7     &none      &kp N9     &none          &trans     &trans     &trans     &none       &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &kp ESC        &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        left_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │  [       │  {       │          │          │   │          │  (       │  )       │  ]       │  ~       │
            &trans     &kp LBKT   &kp LBRC   &none      &trans         &none      &kp LPAR   &kp RPAR   &kp RBKT   &kp TILDE
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  !       │  @       │  #       │  $       │          │   │  *       │          │  =       │  \       │  `       │
            &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp ASTRK  &none      &kp EQUAL  &kp BSLH   &kp GRAVE
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │  &       │  _       │  +       │          │          │
            &none      &trans     &none     &trans     &none            &kp AMPS   &kp UNDER  &kp PLUS   &none    &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        tri_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│ RESET    │  }       │ R        │          │PROFILE 0 │   │          │ Y        │          │          │  RESET   │
           &sys_reset  &kp RBRC   &kp R      &none     &bt BT_SEL 0    &none      &kp Y     &kp CARET  &trans    &sys_reset
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│BOOTLOADER│ HOME     │          │          │PROFILE 1 │   │  -       │          │          │          │BOOTLOADER│
          &bootloader  &kp HOME   &trans     &trans    &bt BT_SEL 1    &MINUS    &none      &kp J       &trans    &bootloader
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │   Z      │          │C         │PROFILE 2 │   │  B       │ DOWN     │|         │          │.         │
            &none     &kp Z       &none     &kp C      &bt BT_SEL 2    &kp B     &kp DOWN   &kp PIPE    &none     &kp DOT
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        gaming_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│Q         │  W       │E         │          │R         │   │          │ U        │   I      │ O        │  RESET   │
           &kp Q      &kp W      &kp E      &none      &kp R           &none      &kp U     &kp I      &kp O       &sys_reset
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│A         │ S        │ D        │F         │ G        │   │  H       │          │ K        │  L       │    "     │
           &kp A        &kp S      &kp D     &kp F      &kp G          &kp H     &none      &kp K       &kp L     &kp SQT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │   X      │          │V         │          │   │  N       │ M        │ ,        │          │/         │
            &none     &kp X       &none     &kp V      &none          &kp N      &kp M      &kp COMMA   &none     &kp FSLH 
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &kp LCTRL &kp SPACE      &ENTER     &tog 4 
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

	right_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│ 	     │          │          │          │          │   │          │ 7        │ 8        │ 9        │          │
            &trans    &trans     &trans      &none      &trans         &none     &kp N7      &kp N8     &kp N9    &trans 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │  4       │ 5        │  6       │
            &trans    &trans      &trans     &trans     &trans         &trans     &none       &kp N4   &kp N5     &kp N6 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │  0       │  1       │ 2        │          │  3       │
           &none       &trans     &none      &trans     &none          &kp N0      &kp N1    &kp N2     &none       &kp N3
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &trans     &tog 5
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
