#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define HRML(k1,k2,k3,k4) &ht LSHFT k1  &ht LALT k2  &ht LCTRL k3  &ht LGUI k4

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;          // fix 1
            flavor = "tap-preferred";
            tapping-term-ms = <200>;       // fix 2
            quick-tap-ms = <125>;          // fix 3
            require-prior-idle-ms = <150>; // fix 4
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_r   { timeout-ms = <50>; key-positions = <2 4>;   bindings = <&kp R>; };
        combo_y   { timeout-ms = <50>; key-positions = <6 7>;   bindings = <&kp Y>; };
        combo_j   { timeout-ms = <50>; key-positions = <15 17>; bindings = <&kp J>; };
        combo_dot { timeout-ms = <50>; key-positions = <27 29>; bindings = <&kp DOT>; };
        combo_z   { timeout-ms = <50>; key-positions = <21 23>; bindings = <&kp Z>; };
        combo_c   { timeout-ms = <50>; key-positions = <12 21>; bindings = <&kp C>; };
        combo_b   { timeout-ms = <50>; key-positions = <14 23>; bindings = <&kp B>; };
        combo_gaming { timeout-ms = <50>; key-positions = <0 1>; bindings = <&tog 4>; };
        combo_numpad { timeout-ms = <50>; key-positions = <1 2>; bindings = <&tog 5>; };
    }; // fix 5 — all timeout-ms values filled in

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;              // fix 6
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
                &kp Q      &kp W      &kp E      &none      &kp T
                &none      &kp U      &kp I      &kp O      &kp P
                HRML(A,    S,         D,         F)         &kp G
                &kp H      &none      &ht RCTRL K &ht RALT L &ht RSHFT SQT
                &none      &kp X      &none      &kp V      &none
                &kp N      &kp M      &kp COMMA  &none      &kp FSLH
                                      &lt 2 TAB  &kp ENTER  &kp SPACE  &lt 1 BSPC
            >;
        };

        right_layer {
            bindings = 
                &kp INS    &kp N1     &kp N2     &kp N3     &none      // fix 7 — N3 moved to col3, col4 is now &none
                &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp COLON
                &kp DEL    &kp N4     &kp N5     &kp N6     &none
                &kp LEFT   &none      &kp UP     &kp RIGHT  &kp SEMI
                &caps_word &kp N7     &kp N8     &kp N9     &kp N0     // N0 added here
                &kp DOWN   &trans     &trans     &none      &trans
                                      &trans     &kp ESC    &trans     &trans
            >;
        };

        left_layer {
            bindings = 
                &trans     &kp LBKT   &kp LBRC   &none      &trans
                &none      &kp LPAR   &kp RPAR   &kp RBKT   &kp TILDE
                &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT
                &kp ASTRK  &none      &kp EQUAL  &kp BSLH   &kp GRAVE
                &none      &trans     &none      &trans     &none
                &kp AMPS   &kp UNDER  &kp PLUS   &none      &trans
                                      &trans     &trans     &trans     &trans
            >;
        };

        tri_layer {
            bindings = 
                &sys_reset  &trans     &kp R      &none     &bt BT_SEL 0
                &none       &kp Y      &trans     &trans    &sys_reset
                &bootloader &trans     &trans     &trans    &bt BT_SEL 1
                &trans      &none      &kp J      &trans    &bootloader
                &none       &kp Z      &none      &kp C     &none
                &kp B       &trans     &trans     &none     &kp DOT
                                       &trans     &trans    &trans     &trans
            >;
        };

        gaming_layer {
            bindings = 
                &kp Q      &kp W      &kp E      &none      &kp R
                &none      &kp U      &kp I      &kp O      &kp P
                &kp A      &kp S      &kp D      &kp F      &kp G
                &kp H      &none      &kp K      &kp L      &kp SQT
                &none      &kp X      &none      &kp V      &none
                &kp N      &kp M      &kp COMMA  &none      &kp FSLH
                                      &kp LCTRL  &kp SPACE  &kp ENTER  &tog 4
            >;
        };

        num_layer {
            bindings = 
                &trans     &trans     &trans     &none      &trans
                &none      &trans     &kp N7     &kp N8     &kp N9
                &trans     &trans     &trans     &trans     &trans
                &trans     &none      &kp N4     &kp N5     &kp N6
                &none      &trans     &none      &trans     &none
                &kp N1     &kp N2     &kp N3     &none      &kp N0
                                      &trans     &trans     &trans     &tog 5
            >;
        };
    };
};
